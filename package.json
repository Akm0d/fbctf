{
  "name": "fbctf",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "mkdir -p src/static/dist/js && browserify src/static/js/app.js --debug -o src/static/dist/js/app.js",
    "build:css": "sass --style=expanded --embed-sources src/static/css/scss/fb-ctf.scss src/static/css/fb-ctf.css"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-flow": "7.27.1",
    "babelify": "10.0.0",
    "browserify": "17.0.1",
    "sass": "1.93.2"
  },
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "presets": [
            "@babel/preset-flow"
          ]
        }
      ]
    ]
  },
  "dependencies": {
    "d3": "^3.5.16",
    "dropkickjs": "2.1.10",
    "hoverintent-jqplugin": "^0.2.1",
    "jquery": "^2.2.3",
    "keycode": "^2.1.1",
    "typed.js": "^1.1.1",
    "bxslider": "4.2.6"
  }
}
